# Copia a web/.env (Vite solo expone variables VITE_* al navegador).
# ADVERTENCIA: VITE_OPENAI_API_KEY queda visible en el bundle. Solo desarrollo personal.

VITE_OPENAI_API_KEY=sk-tu-clave-aqui
# Proxy en dev (vite.config.ts). En producción configura el mismo proxy en nginx.
VITE_OPENAI_API_BASE=/openai/v1

# Opcional: API Python local (si no usas OpenAI directo)
# VITE_COACH_API_URL=
