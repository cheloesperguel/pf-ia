{
  "version": 1,
  "knowledge_doc": "docs/exercises/press_militar.md",
  "movement": "press",
  "tts": {
    "enabled": true,
    "voice": "en-US-JennyNeural",
    "start_phrase": "Let's go."
  },
  "voice_coach": {
    "enabled": true,
    "show_hud_status": false
  },
  "workout": {
    "enabled": true,
    "program_file": "workout_programs/press_4x12.json"
  },
  "setup_pose": {
    "enabled": true,
    "position": "seated",
    "hold_ms": 1500,
    "help_key": "setup_rack",
    "show_reference_pose": true,
    "reference_pose_flash_s": 2.5,
    "reference_pose": {
      "landmarks": {
        "LEFT_SHOULDER": { "x": 0.38, "y": 0.35 },
        "RIGHT_SHOULDER": { "x": 0.62, "y": 0.35 },
        "LEFT_ELBOW": { "x": 0.3, "y": 0.48 },
        "RIGHT_ELBOW": { "x": 0.7, "y": 0.48 },
        "LEFT_WRIST": { "x": 0.28, "y": 0.55 },
        "RIGHT_WRIST": { "x": 0.72, "y": 0.55 }
      }
    },
    "tts": {
      "intro": "Phase one: seated overhead press. Back supported, face the camera, arms in rack with elbows bent.",
      "go": "Go! Start the seated press."
    },
    "checks": [
      {
        "id": "setup_frontal",
        "kind": "frontal",
        "message": "Seated, facing the camera: shoulders, elbows and wrists visible."
      },
      {
        "id": "setup_arms",
        "kind": "visibility_both_arms",
        "message": "Make sure both full arms are visible (shoulder, elbow, wrist)."
      },
      {
        "id": "setup_rack_depth",
        "kind": "metric",
        "metric": "elbow_angle_min_deg",
        "op": "gte",
        "value": 65,
        "message": "Bend your elbows more: seated rack (~90°, not arms straight overhead)."
      },
      {
        "id": "setup_not_locked",
        "kind": "metric",
        "metric": "elbow_angle_min_deg",
        "op": "lte",
        "value": 128,
        "message": "Don't start fully locked out: lower to rack before the start."
      },
      {
        "id": "setup_scapular_plane",
        "kind": "metric",
        "metric": "elbow_scapular_lateral_frac_max",
        "op": "lte",
        "value": 0.89,
        "message": "Scapular plane at setup: tuck elbows toward the bar (not flared wide)."
      }
    ]
  },
  "exercise_id": "press_militar",
  "display_name": "Seated overhead press",
  "pose_model": "heavy",
  "min_rep_interval_ms": 650,
  "smoothing_alpha": 0.35,
  "hud": {
    "angle_label": "Elbow (min.)"
  },
  "rep_detection": {
    "elbow_angle_metric": "elbow_angle_min_deg",
    "top_min_deg": 145,
    "bottom_max_deg": 105
  },
  "arms_visibility": {
    "min_visibility": 0.36
  },
  "visual": {
    "wrist_elbow_stack_sin_max": 0.3,
    "pulse_hz": 2.2,
    "show_elbow_z": true,
    "show_bar_guide": true,
    "elbow_z_offset_target": { "min": 0.02, "max": 0.1 },
    "bar_rack_guide": {
      "below_nose_min": 0.04,
      "below_nose_max": 0.22,
      "vs_shoulder_max": 0.12
    }
  },
  "frontal": {
    "require_hips": false,
    "min_shoulder_pair_visibility": 0.35,
    "min_shoulder_width_norm": 0.1
  },
  "rules": [
    {
      "id": "frontal_view",
      "help_key": "frontal_view",
      "kind": "frontal",
      "priority": 1,
      "tts_enabled": true,
      "blocks_rep": true,
      "message": "Seated, facing the camera (shoulders and arms visible; legs not required)."
    },
    {
      "id": "visibility_both_arms",
      "help_key": "visibility_both_arms",
      "kind": "visibility_both_arms",
      "priority": 2,
      "tts_enabled": true,
      "requires": ["frontal_view"],
      "blocks_rep": false,
      "message": "Make sure shoulders, elbows and wrists are visible on both arms."
    },
    {
      "id": "elbows_scapular_plane",
      "help_key": "elbows_scapular_plane",
      "kind": "metric",
      "metric": "elbow_scapular_lateral_frac_max",
      "op": "lte",
      "value": 0.9,
      "phase": "bottom",
      "priority": 3,
      "tts_enabled": false,
      "requires": ["frontal_view", "visibility_both_arms"],
      "blocks_rep": false,
      "message": "Tuck elbows toward the bar: don't flare them out to the sides."
    },
    {
      "id": "elbows_forward_rack",
      "help_key": "elbows_scapular_plane",
      "kind": "metric",
      "metric": "elbow_scapular_forward_frac_min",
      "op": "gte",
      "value": 0.22,
      "phase": "bottom",
      "priority": 6,
      "tts_enabled": false,
      "requires": ["frontal_view", "visibility_both_arms"],
      "blocks_rep": false,
      "message": "Bring elbows slightly forward, not pinned to your sides."
    },
    {
      "id": "wrist_elbow_stack",
      "help_key": "wrist_elbow_stack",
      "kind": "metric",
      "metric": "wrist_elbow_stack_sin_max",
      "op": "lte",
      "value": 0.2,
      "phase": "bottom",
      "priority": 4,
      "tts_enabled": false,
      "requires": ["frontal_view", "visibility_both_arms"],
      "blocks_rep": false,
      "message": "Stack wrist over elbow on the way down"
    },
    {
      "id": "elbows_below_shoulders",
      "help_key": "elbows_below_shoulders",
      "kind": "metric",
      "metric": "elbow_below_shoulder_min_norm",
      "op": "gte",
      "value": 0.02,
      "phase": "bottom",
      "priority": 5,
      "tts_enabled": false,
      "requires": ["frontal_view", "visibility_both_arms"],
      "blocks_rep": false,
      "message": "Seated rack: prioritize elbow angle; this image cue is reference only."
    }
  ]
}
